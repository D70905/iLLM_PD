# iLLM-PD optional language-model configuration
#
# Copy this file to .env for local runs that call an external language-model API.
# Do not place real credentials in a public repository or journal upload.

CHATFIRE_API_KEY=<YOUR_CHATFIRE_API_KEY>
CHATFIRE_BASE_URL=https://api.chatfire.cn/v1
CHATFIRE_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional local model endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
