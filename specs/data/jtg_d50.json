    "G13_kT_modification_formulas": {
      "_ref": "Eqs. G.1.3-1 through G.1.3-15",
      "_status": "formulas verified, NOT applied in current implementation",
      "_simplification": "We use k_T_hat (base structure) values from Table G.1.2 directly, without applying the structure-specific modification of Eq. G.1.3-1. This is acceptable because the modifications are second-order corrections; full implementation can be added as future work.",
      "form": "k_Ti = A_h · A_E · k_Ti_hat^(1 + B_h + B_E)",
      "where": "A_h, A_E, B_h, B_E are functions of λ_E = E_a*/E_b* and λ_h = h_a*/h_b*"
    },

