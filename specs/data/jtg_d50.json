  "appendix_B11_asphalt_fatigue": {
    "_ref": "Appendix B.1, Eq. B.1.1-1",
    "_status": "verified",
    "equation_form": "N_f1 = 6.32 × 10^(15.96 - 0.29·β) · k_a · k_b · k_T1^(-1) · (1/ε_a)^3.97 · (1/E_a)^1.58 · VFA^2.72",
    "variable_units": {
      "ε_a": "10^-6 (microstrain value, e.g. 100)",
      "E_a": "MPa", "VFA": "%", "h_a": "mm"
    },
    "coefficients_verified": {
      "prefactor_6.32": 6.32,
      "log10_exponent_constant_15.96": 15.96,
      "beta_coefficient_0.29": 0.29,
      "inverse_epsilon_a_exp_3.97": 3.97,
      "inverse_E_a_exp_1.58": 1.58,
      "VFA_exp_2.72": 2.72
    }
  },

  "appendix_B12_k_b": {
    "_ref": "Eq. B.1.1-2",
    "_status": "verified",
    "equation_form": "k_b = [(1 + 0.3·E_a^0.43·VFA^(-0.85)·exp(0.024·h_a - 5.41)) / (1 + exp(0.024·h_a - 5.41))]^3.33"
  },

